{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:info-minimalism:1.0.0:evaluation-result",
  "title": "Info-Minimalism 1.0.0 Evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "standard_version",
    "evaluation_id",
    "mode",
    "evaluation_status",
    "artifact",
    "context",
    "measurement",
    "meaning_ledger",
    "preservation_constraints",
    "minimal_adequate_renderings",
    "burden_findings",
    "adequacy_gaps",
    "metrics",
    "uncertainty",
    "limitations",
    "release_status",
    "latest_standard",
    "scenarios",
    "crac_allocations",
    "qualification",
    "scope_notice"
  ],
  "properties": {
    "standard_version": {
      "const": "1.0.0"
    },
    "evaluation_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "message",
        "sequence",
        "channel"
      ]
    },
    "evaluation_status": {
      "enum": [
        "complete",
        "partial",
        "insufficient_context"
      ]
    },
    "artifact": {
      "$ref": "#/$defs/artifact"
    },
    "context": {
      "$ref": "#/$defs/context"
    },
    "measurement": {
      "$ref": "#/$defs/measurement"
    },
    "meaning_ledger": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/meaningEntry"
      }
    },
    "preservation_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "constraint",
          "evidence",
          "confidence"
        ],
        "properties": {
          "constraint": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "$ref": "#/$defs/confidence"
          }
        }
      }
    },
    "minimal_adequate_renderings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rendering"
      }
    },
    "burden_findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/burdenFinding"
      }
    },
    "adequacy_gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/adequacyGap"
      }
    },
    "metrics": {
      "$ref": "#/$defs/metrics"
    },
    "sequence_findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "channel_findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "uncertainty": {
      "$ref": "#/$defs/uncertainty"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "release_status": {
      "const": "stable"
    },
    "latest_standard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "installed_version",
        "latest_published_version",
        "checked_at",
        "source",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "unverified"
          ]
        },
        "installed_version": {
          "const": "1.0.0"
        },
        "latest_published_version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "checked_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "encounter_mode",
          "audience",
          "context_assumptions"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "encounter_mode": {
            "$ref": "#/$defs/contextEncounter"
          },
          "audience": {
            "type": "string",
            "minLength": 1
          },
          "context_assumptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "crac_allocations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "allocation_id",
          "scenario_id",
          "rendering_id",
          "finding_id",
          "cost_basis",
          "boundary_id",
          "start",
          "end",
          "observed_units",
          "replacement_units",
          "removable_units"
        ],
        "properties": {
          "allocation_id": {
            "type": "string",
            "minLength": 1
          },
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "rendering_id": {
            "type": "string",
            "minLength": 1
          },
          "finding_id": {
            "type": "string",
            "pattern": "^B[0-9]+$"
          },
          "cost_basis": {
            "$ref": "#/$defs/costBasis"
          },
          "boundary_id": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "observed_units": {
            "type": "number",
            "minimum": 0
          },
          "replacement_units": {
            "type": "number",
            "minimum": 0
          },
          "removable_units": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "artifact_identifier",
        "final_content",
        "scenario_ids",
        "evaluation_complete",
        "meaning_function_confirmed",
        "material_uncertainty",
        "local_context_repair_needed",
        "supporting_finding_ids",
        "reason",
        "scope_notice"
      ],
      "properties": {
        "status": {
          "enum": [
            "meets_requirements",
            "revision_needed",
            "undetermined",
            "out_of_scope"
          ]
        },
        "artifact_identifier": {
          "type": "string",
          "minLength": 1
        },
        "final_content": {
          "type": "string"
        },
        "scenario_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evaluation_complete": {
          "type": "boolean"
        },
        "meaning_function_confirmed": {
          "type": "boolean"
        },
        "material_uncertainty": {
          "type": "boolean"
        },
        "local_context_repair_needed": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "True: a local-context repair is needed. False: the evaluated context needs no repair. Null: whether a repair is needed cannot be determined; explain why in qualification.reason. Only false can support meets_requirements."
        },
        "supporting_finding_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "scope_notice": {
          "const": "Applies only to the exact evaluated final content and declared scenarios under the pinned Standard; not source certification, a latest-published-standard claim, or proof of future compliance."
        }
      }
    },
    "scope_notice": {
      "const": "Version-pinned attention-cost evaluation; not publisher certification, truth verification, safety review, or an overall quality judgment."
    }
  },
  "$defs": {
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "boundary",
        "platform",
        "capture_date",
        "content",
        "access_status"
      ],
      "properties": {
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "boundary": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "capture_date": {
          "type": "string",
          "format": "date"
        },
        "content": {
          "type": "string"
        },
        "part_count": {
          "type": "integer",
          "minimum": 1
        },
        "sample_rule": {
          "type": "string"
        },
        "sample_window": {
          "type": "string"
        },
        "access_status": {
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        },
        "channel_sampling": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "window",
            "selection_rule",
            "sample_count",
            "population_count",
            "access_gaps",
            "exclusions",
            "complete",
            "visible_deletions"
          ],
          "properties": {
            "window": {
              "type": "string",
              "minLength": 1
            },
            "selection_rule": {
              "type": "string",
              "minLength": 1
            },
            "sample_count": {
              "type": "integer",
              "minimum": 0
            },
            "population_count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "access_gaps": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "exclusions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "complete": {
              "type": "boolean"
            },
            "visible_deletions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "contextEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "statement"
      ],
      "properties": {
        "tier": {
          "enum": [
            "C0_artifact",
            "C1_encounter",
            "C2_audience",
            "C3_external"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encounter_mode",
        "audience",
        "language",
        "accessibility_assumptions",
        "supplied_context",
        "medium_constraints",
        "missing_context"
      ],
      "properties": {
        "encounter_mode": {
          "enum": [
            "isolated",
            "in_sequence",
            "subscriber_timeline",
            "other"
          ]
        },
        "encounter_mode_detail": {
          "type": "string"
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "accessibility_assumptions": {
          "type": "string"
        },
        "supplied_context": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contextEvidence"
          }
        },
        "medium_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_context": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "cost_bases",
        "boundary_rules",
        "comparability_limits"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "tokenizer_or_count_rule": {
          "type": "string"
        },
        "cost_bases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/costBasis"
          }
        },
        "boundary_rules": {
          "type": "string",
          "minLength": 1
        },
        "comparability_limits": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "costBasis": {
      "enum": [
        "lexical_units",
        "grapheme_clusters",
        "media_seconds",
        "screens",
        "required_actions",
        "transitions",
        "custom"
      ]
    },
    "meaningEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "meaning",
        "type",
        "evidence",
        "context_tier",
        "role",
        "confidence",
        "dependencies"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^M[0-9]+$"
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "propositional",
            "directive",
            "qualifying",
            "relational",
            "affective",
            "aesthetic",
            "navigational",
            "accessibility",
            "other"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "context_tier": {
          "enum": [
            "C0_artifact",
            "C1_encounter",
            "C2_audience",
            "C3_external"
          ]
        },
        "role": {
          "enum": [
            "core",
            "supporting",
            "incidental"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^M[0-9]+$"
          }
        }
      }
    },
    "rendering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "fidelity",
        "preserved_meaning_ids",
        "possible_losses",
        "feasibility",
        "cross_medium",
        "scenario_id",
        "rendering_id"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "fidelity": {
          "enum": [
            "confirmed",
            "uncertain",
            "failed"
          ]
        },
        "preserved_meaning_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^M[0-9]+$"
          }
        },
        "possible_losses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "feasibility": {
          "type": "string",
          "minLength": 1
        },
        "cross_medium": {
          "type": "boolean"
        },
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "rendering_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "burdenFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "observed",
        "category",
        "treatment",
        "alternative",
        "preservation_rationale",
        "cost_basis",
        "removable_units",
        "confidence",
        "possible_necessity",
        "constraint_bound",
        "scenario_id",
        "rendering_id",
        "disposition",
        "resolution",
        "disposition_reason",
        "allocation_ids",
        "material_to_qualification",
        "meaning_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^B[0-9]+$"
        },
        "observed": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string"
        },
        "category": {
          "enum": [
            "R1",
            "R2",
            "R3",
            "R4",
            "R5",
            "R6",
            "R7",
            "R8",
            "R9",
            "R10",
            "R11",
            "R12",
            "RX"
          ]
        },
        "treatment": {
          "enum": [
            "delete",
            "replace",
            "merge",
            "move",
            "consolidate"
          ]
        },
        "alternative": {
          "type": "string"
        },
        "preservation_rationale": {
          "type": "string",
          "minLength": 1
        },
        "cost_basis": {
          "$ref": "#/$defs/costBasis"
        },
        "removable_units": {
          "$ref": "#/$defs/metricValue"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "possible_necessity": {
          "type": "string"
        },
        "constraint_bound": {
          "type": "boolean"
        },
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "rendering_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "demonstrated",
            "contested",
            "excluded"
          ]
        },
        "resolution": {
          "enum": [
            "unresolved",
            "resolved"
          ]
        },
        "disposition_reason": {
          "type": "string",
          "minLength": 1
        },
        "allocation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "material_to_qualification": {
          "type": "boolean"
        },
        "meaning_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^M[0-9]+$"
          }
        }
      }
    },
    "adequacyGap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "gap",
        "repair",
        "cost_basis",
        "repair_units",
        "confidence",
        "scenario_id",
        "rendering_id",
        "resolution"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^A[0-9]+$"
        },
        "gap": {
          "type": "string",
          "minLength": 1
        },
        "repair": {
          "type": "string",
          "minLength": 1
        },
        "cost_basis": {
          "$ref": "#/$defs/costBasis"
        },
        "repair_units": {
          "$ref": "#/$defs/metricValue"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "rendering_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "resolution": {
          "enum": [
            "unresolved",
            "resolved"
          ]
        }
      }
    },
    "costMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cost_basis",
        "observed_attention_cost",
        "mar_cost",
        "conservative_removable_cost",
        "adequacy_repair_cost",
        "retained_attention_share",
        "confidence",
        "rationale",
        "scenario_id",
        "rendering_id",
        "allocation_ids"
      ],
      "properties": {
        "cost_basis": {
          "$ref": "#/$defs/costBasis"
        },
        "observed_attention_cost": {
          "$ref": "#/$defs/metricValue",
          "description": "A reported OAC is the total for this evaluation's boundary and cost base. If only an excerpt is countable, withhold whole-boundary OAC and put the excerpt count in measurement.boundary_rules. A reason or caveat cannot turn an excerpt count into a whole-boundary total."
        },
        "mar_cost": {
          "$ref": "#/$defs/metricValue"
        },
        "conservative_removable_cost": {
          "$ref": "#/$defs/metricValue"
        },
        "adequacy_repair_cost": {
          "$ref": "#/$defs/metricValue"
        },
        "retained_attention_share": {
          "allOf": [
            {
              "$ref": "#/$defs/metricValue"
            },
            {
              "properties": {
                "value": {
                  "maximum": 1
                }
              }
            }
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "rendering_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "allocation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "diagnosticMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "value",
        "numerator",
        "denominator",
        "cost_basis",
        "confidence",
        "rationale",
        "scenario_id",
        "rendering_id"
      ],
      "properties": {
        "name": {
          "enum": [
            "payload_latency",
            "repetition_burden",
            "context_overhead",
            "capture_overhead",
            "fragmentation_overhead",
            "cross_item_duplication",
            "update_yield"
          ]
        },
        "status": {
          "enum": [
            "reported",
            "not_applicable",
            "withheld"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "numerator": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "denominator": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cost_basis": {
          "oneOf": [
            {
              "$ref": "#/$defs/costBasis"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "rendering_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "reported"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number"
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              },
              "numerator": {
                "type": "null"
              },
              "denominator": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cost_metrics",
        "diagnostics",
        "heterogeneous_costs_not_summed",
        "overall_score_withheld"
      ],
      "properties": {
        "cost_metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/costMetric"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnosticMetric"
          }
        },
        "heterogeneous_costs_not_summed": {
          "const": true
        },
        "overall_score_withheld": {
          "const": true
        }
      }
    },
    "uncertaintyAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidence",
        "rationale"
      ],
      "properties": {
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence",
        "meaning",
        "counterfactual",
        "exposure",
        "sensitivity_cases"
      ],
      "properties": {
        "evidence": {
          "$ref": "#/$defs/uncertaintyAxis"
        },
        "meaning": {
          "$ref": "#/$defs/uncertaintyAxis"
        },
        "counterfactual": {
          "$ref": "#/$defs/uncertaintyAxis"
        },
        "exposure": {
          "$ref": "#/$defs/uncertaintyAxis"
        },
        "sensitivity_cases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "contextEncounter": {
      "enum": [
        "isolated",
        "in_sequence",
        "subscriber_timeline",
        "other"
      ]
    },
    "metricValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "reported",
            "withheld",
            "not_applicable"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "reported"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "channel"
          }
        }
      },
      "then": {
        "properties": {
          "artifact": {
            "required": [
              "channel_sampling"
            ]
          }
        }
      }
    }
  ]
}
